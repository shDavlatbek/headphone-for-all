# Line endings. Every text file is stored with LF and checked out with LF on every platform,
# whatever the local `core.autocrlf` says, so a Windows checkout has the same bytes as Linux and
# macOS (tests compare file contents, e.g. the C header of hfa-ffi; shell scripts run in Linux
# containers; generated bindings are diffed in CI).
* text=auto eol=lf

# Windows-only scripts and resources keep CRLF in the working tree, as a Windows checkout with
# core.autocrlf always gave them (cmd.exe mis-parses LF-only batch files around labels and
# long lines; rc.exe, Inno Setup and PowerShell are then fed exactly what they were built with).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.iss text eol=crlf


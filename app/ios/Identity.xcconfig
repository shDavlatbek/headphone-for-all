// Identity.xcconfig - bundle ids and App Group of the iOS app and its broadcast extension.
//
// Included by Flutter/Debug.xcconfig, Flutter/Release.xcconfig (Runner) and
// HfaBroadcast/HfaBroadcast.xcconfig. App IDs and App Groups belong to one Apple developer team,
// so to run on a device with another team, create Identity.local.xcconfig next to this file
// (git-ignored) with your own prefix, for example:
//
//   HFA_BUNDLE_ID = com.example.hfa
//   DEVELOPMENT_TEAM = ABCDE12345
//
// Everything else follows from HFA_BUNDLE_ID: the app is $(HFA_BUNDLE_ID), the extension
// $(HFA_BUNDLE_ID).broadcast, the App Group group.$(HFA_BUNDLE_ID) (the entitlements of both
// targets, and the HfaAppGroup / HfaBroadcastExtension Info.plist keys that HfaShared.swift
// reads). Register the two App IDs with the App Groups capability and that group.

HFA_BUNDLE_ID = io.github.shdavlatbek.hfa
HFA_BROADCAST_BUNDLE_ID = $(HFA_BUNDLE_ID).broadcast
HFA_APP_GROUP = group.$(HFA_BUNDLE_ID)

#include? "Identity.local.xcconfig"
